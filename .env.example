PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:4000
NODE_ENV=development
# Leave empty for local SQLite. For PostgreSQL, set a connection string.
DATABASE_URL=
SQLITE_PATH=data/relay.db
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@gmail.com
# Required on first startup. Demo password is printed in README, never use in production.
SEED_ADMIN_PASSWORD=Admin@123
# Optional override for all agents. Omit to use user1@123 through user10@123.
# SEED_AGENT_PASSWORD=
# Explicitly enable requested dummy credentials on a hosted demonstration only.
DEMO_MODE=false
COMPANY_NAME=Relay Logistics
# Trust only a known reverse proxy in production (e.g. loopback).
TRUST_PROXY=
